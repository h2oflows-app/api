# Staging environment — copy to .env.staging on the EC2 host, fill real values.
# Used by docker-compose.staging.yml.

POSTGRES_USER=h2oflows
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
POSTGRES_DB=h2oflows

# Staging Supabase project (separate from prod) — JWKS for JWT verification.
SUPABASE_JWKS_URL=https://STAGING_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# AI services — share prod keys or leave blank to disable RAG/search on staging.
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
